{
  "_comment": "Shared defaults for every environment. Per-environment values go in settings.<APP_ENV>.json (not committed); secrets go in .env.",

  "app": {
    "app_name": "Paperless Cheque OCR API",
    "app_version": "1.0.0",
    "api_v1_prefix": "/api/v1",
    "docs_enabled": true,
    "log_level": "INFO",
    "logs_dir": "logs",
    "cors_origins": []
  },

  "ocr_model": {
    "gemini_temperature": 0.0,
    "gemini_top_p": 0.95,
    "gemini_top_k": 40,
    "gemini_max_output_tokens": 4096,
    "gemini_seed": null,
    "gemini_thinking_budget": 0,
    "gemini_thinking_level": null,
    "gemini_timeout_seconds": 120,
    "gemini_max_retries": 2
  },

  "uploads": {
    "max_files_per_request": 20,
    "max_file_size_mb": 15,
    "max_concurrent_requests": 5
  },

  "file_urls": {
    "allowed_file_hosts": [".blob.core.windows.net"],
    "download_timeout_seconds": 60
  },

  "blob_storage": {
    "azure_sas_expiry_hours": 0
  },

  "image_processing": {
    "image_processing_enabled": true,
    "processed_file_suffix": "_processed",
    "crop_padding_percent": 2.0,
    "pdf_render_dpi": 200,
    "processed_jpeg_quality": 92
  }
}
