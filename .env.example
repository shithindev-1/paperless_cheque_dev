# Copy to .env and fill in. Never commit .env.
# Secrets only. Everything else lives in config/settings.json (shared defaults)
# and config/settings.<APP_ENV>.json (per environment, copied from settings.example.json).

# local | uat | prod  -> loads config/settings.<APP_ENV>.json
APP_ENV=local

# Keys clients must send in the X-API-Key header (comma-separated to allow rotation).
# Optional when APP_ENV=local; required for uat / prod.
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEYS=

# OCR model API key
GEMINI_API_KEY=

# Azure Blob Storage connection string
# e.g. DefaultEndpointsProtocol=https;AccountName=<account>;AccountKey=<key>;EndpointSuffix=core.windows.net
AZURE_STORAGE_CONNECTION_STRING=
