# Copy to .env and fill in. Never commit .env.

# ───────────────────────── App ─────────────────────────
APP_NAME="Paperless Cheque OCR API"
APP_VERSION=1.0.0
# local | uat | prod
APP_ENV=local
# Swagger UI (/docs), ReDoc and /openapi.json
DOCS_ENABLED=true
LOG_LEVEL=INFO
# logs/app/YYYY-MM-DD.log and logs/results/YYYY-MM-DD.jsonl (UAE date)
LOGS_DIR=logs
# JSON list of allowed frontend origins
CORS_ORIGINS=["http://localhost:3000"]

# ───────────────────────── OCR model (required) ────────
GEMINI_API_KEY=<your-api-key>
GEMINI_MODEL=<model-name>

# Sampling (low temperature = deterministic extraction)
GEMINI_TEMPERATURE=0.0
GEMINI_TOP_P=0.95
GEMINI_TOP_K=40
GEMINI_MAX_OUTPUT_TOKENS=4096
# Leave empty for model default
GEMINI_SEED=

# Thinking — set ONE of these, leave the other empty.
GEMINI_THINKING_BUDGET=0
GEMINI_THINKING_LEVEL=

# Reliability
GEMINI_TIMEOUT_SECONDS=120
GEMINI_MAX_RETRIES=2

# ───────────────────────── Uploads ─────────────────────
MAX_FILES_PER_REQUEST=20
MAX_FILE_SIZE_MB=15
MAX_CONCURRENT_REQUESTS=5

# ───────────────────────── File URLs (/cheques/match) ─
# JSON list; ".domain" matches subdomains, [] allows any host
ALLOWED_FILE_HOSTS=[".blob.core.windows.net"]
DOWNLOAD_TIMEOUT_SECONDS=60
# Local testing only (APP_ENV=local): folder whose files can be referenced by name
LOCAL_FILES_DIR=
